{
  "compilerOptions": {
    "outDir": ".millennium/Dist",
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}
