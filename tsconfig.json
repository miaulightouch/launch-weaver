{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}
